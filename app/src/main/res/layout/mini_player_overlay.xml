<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerContainer"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="36dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/app_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMiniCover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:contentDescription="@string/mini_player_drag_hint"
            android:scaleType="centerCrop"
            android:src="@drawable/cover_placeholder"
            app:shapeAppearanceOverlay="@style/MintWaveCircularCover"
            app:strokeColor="@color/app_surface"
            app:strokeWidth="2dp" />

        <LinearLayout
            android:id="@+id/miniExpandedContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/miniTrackInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/open_player_details"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMiniPrevious"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/app_sage_dark" />

                <ImageButton
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play_pause"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/app_sage" />

                <ImageButton
                    android:id="@+id/btnMiniNext"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/app_sage_dark" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/miniProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/app_coral"
                android:secondaryProgressTint="@color/app_surface_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMiniCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvMiniTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
