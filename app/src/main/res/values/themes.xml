<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TimedMusicPlayer.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
    </style>

    <style name="Theme.TimedMusicPlayer" parent="Theme.TimedMusicPlayer.Base">
        <item name="colorPrimary">@color/app_green_primary</item>
        <item name="colorPrimaryVariant">@color/app_green_primary_dark</item>
        <item name="colorSecondary">@color/app_green_accent</item>
        <item name="colorSecondaryVariant">@color/app_green_primary</item>
        <item name="themeSoftColor">@color/app_green_soft</item>
        <item name="android:statusBarColor">@color/app_background</item>
    </style>

