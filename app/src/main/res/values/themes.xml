    <style name="MintWaveCircularCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="EditorialRoundedCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="EditorialPlayerCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.MintMusic.FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/filter_chip_background</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeColor">@color/app_hairline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textStyle">normal</item>
    </style>
